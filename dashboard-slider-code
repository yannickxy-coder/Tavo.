      var v = el.getAttribute('data-tabs-bg') || '';
      return v ? v === name : root.contains(el);
    });
    var bgKlassen = slides.map(function (s, i) {
      return s.getAttribute('data-tabs-bg-class')
          || (buttons[i] && buttons[i].getAttribute('data-tabs-bg-class'))
          || '';
    });
    var bgDauer = anteil(root, 'data-tabs-bg-duration', 0.45);
    bgs.forEach(function (el) { el.style.setProperty('--tabs-bg-duration', bgDauer + 's'); });
    if (bgs.length && !bgKlassen.some(Boolean)) {
      console.info('[Tabs] "' + name + '": Hintergrund ohne [data-tabs-bg-class] — es wird nur [data-tabs-bg-active] gesetzt.');
    }

    if (idles.length && !dotsBox) console.warn('[Tabs] "' + name + '": [data-tabs-idle] ohne [data-tabs-dots] — es gibt nichts zum Umschalten.', root);
    if (dotsBox && !dotsBox.querySelector('[data-tabs-dot]')) console.warn('[Tabs] "' + name + '": keine Punkt-Vorlage [data-tabs-dot] gefunden — es werden schlichte Punkte gebaut.', dotsBox);
    console.info('[Tabs] "' + name + '": ' + slides.length + ' Slides · Nav '
      + (hatNav ? (root.contains(nav) ? 'ja' : 'ja (ausgelagert)') : 'nein')
      + ' · Panels ' + (panels.length ? 'ja' : 'nein') + ' · Pille ' + (pill ? 'ja' : 'nein')
      + ' · Punkte ' + (dotsBox ? 'ja' : 'nein') + ' · Ruheinhalt ' + (idles.length || 'nein')
      + ' · Hintergrund ' + (bgs.length || 'nein'));

    /* ── Zustand ─────────────────────────────────────────────── */
    var ziele = [], rects = [], hoehen = [], breitenIdle = [], breiteDots = 0;
    var rohZiel = 0, rohWeich = 0, navZiel = 0, navWeich = 0, tickt = false;
    var navIndex = -1, blendIndex = -1, idleIndex = 0, anker = 0;
    var schub = { v: 0 }, stauch = { v: 1 };
    var endeT = null, dotT = null, korrekturT = null, roT = null;
    var gleitet = false, ghostAn = false, hovert = false, beruehrt = false, beruehrtT = null;
    var gesperrt = false, gefuehrt = false;
    var zieh = { an: false, x: 0, start: 0, weg: 0, index: 0, letztX: 0, letztT: 0, v: 0 };
    var navProxy = { v: 0 }, navEigen = null;
    var fuehr = { v: 0 }, fuehrF = 0;

    var klemm = function (i) { return Math.max(0, Math.min(slides.length - 1, i)); };

    /* ── Torschwelle ─────────────────────────────────────────────
       Gemessen wird der Weg AB DEM STARTPUNKT, nicht ab der linken
       Nachbarslide. Sonst wird die Schwelle richtungsabhängig: bei
       t=1 wartet die Pille vorwärts bis zum Einrasten, rückwärts
       läuft sie sofort los, weil Math.floor() beim Rückweg schon
       auf der Zielslide steht. Genau das war der Unterschied
       zwischen 1→2 und 2→1. */
    function tor(f, t, anker) {
      if (t <= 0) return f;
      var d = f - anker;
      if (!d) return anker;
      var s = d > 0 ? 1 : -1;
      var abs = Math.abs(d);
      var ganze = Math.floor(abs);
      var rest = abs - ganze;
      var g = t >= 1 ? 0 : kappe((rest - t) / (1 - t), 0, 1);
      return anker + s * (ganze + g);
    }

    // Der Startpunkt wandert mit, sobald ein voller Schritt liegt.
    function ankerNachziehen() {
      var d = rohZiel - anker;
      if (Math.abs(d) >= 1) anker += (d > 0 ? 1 : -1) * Math.floor(Math.abs(d));
    }

    /* ── Messen ──────────────────────────────────────────────── */
    function scrollZiel(i) {
      var f = slides[i];
      var a = (getComputedStyle(f).scrollSnapAlign || 'center').split(' ').pop();
      var v = a === 'start' ? f.offsetLeft - (parseFloat(getComputedStyle(track).paddingLeft) || 0)
            : a === 'end'   ? f.offsetLeft + f.offsetWidth - track.clientWidth
            :                 f.offsetLeft - (track.clientWidth - f.offsetWidth) / 2;
      return Math.max(0, Math.min(track.scrollWidth - track.clientWidth, v));
    }

    // Jeder Zustand der Pille wird einmal frei gemessen, danach steht
    // die Breite fest und wird nur noch getweent.
    function pilleMessen() {
      if (!pill) return;
      var vorher = pill.style.width;
      pill.style.width = 'auto';
      var cs = getComputedStyle(pill);
      var rand = (parseFloat(cs.paddingLeft) || 0) + (parseFloat(cs.paddingRight) || 0)
               + (parseFloat(cs.borderLeftWidth) || 0) + (parseFloat(cs.borderRightWidth) || 0);
      breitenIdle = idles.map(function (el) { return Math.ceil(el.offsetWidth + rand); });

      // Abstand von Punktmitte zu Punktmitte — daraus ergibt sich, wie
      // weit die Reihe geschoben werden muss und wie breit die Pille
      // sein darf. Ohne Zentrierung bleibt es bei der vollen Reihe.
      schritt = punkte.length > 1 ? Math.abs(punkte[1].offsetLeft - punkte[0].offsetLeft) : 0;
      if (dotsBox) {
        var sichtbar = Math.min(punkte.length, dotFenster);
        var eigen = punkte[0] ? punkte[0].offsetWidth : 0;
        breiteDots = (zentriert && schritt && sichtbar < punkte.length)
          ? Math.ceil(schritt * (sichtbar - 1) + eigen + rand)
          : Math.ceil(dotsBox.offsetWidth + rand);
      } else {
        breiteDots = breitenIdle[0] || pill.offsetWidth;
      }
      pill.style.width = vorher || pillZiel() + 'px';
    }

    function messen() {
      ziele  = slides.map(function (_, i) { return scrollZiel(i); });
      hoehen = (panels.length ? panels : slides).map(function (s) { return s.offsetHeight; });
      if (hatNav) {
        rects = buttons.map(function (b) {
          return { left: b.offsetLeft, width: b.offsetWidth, top: b.offsetTop, height: b.offsetHeight };
        });
      }
      pilleMessen();
      if (slides[0] && track.clientWidth && slides[0].offsetWidth < track.clientWidth * 0.6) {
        console.warn('[Tabs] "' + name + '": Die Slides sind schmaler als der Track. Breite im Designer auf 100% stellen.');
      }
    }

    /* ── Bruchzahl aus der Scrollposition ────────────────────── */
    function bruch() {
      var x = track.scrollLeft, n = ziele.length;
      if (n < 2) return 0;
      if (x <= ziele[0]) return 0;
      if (x >= ziele[n - 1]) return n - 1;
      for (var i = 0; i < n - 1; i++) {
        var a = ziele[i], b = ziele[i + 1];
        if (x >= a && x <= b) return b === a ? i : i + (x - a) / (b - a);
      }
      return n - 1;
    }

    /* ── Glättung ────────────────────────────────────────────────
       Roh gescrollt wird ruckartig: Trackpads liefern Sprünge, das
       Einrasten kommt in wenigen groben Frames. Beide Werte jagen
       ihrem Ziel mit fester Trägheit hinterher — die Pille dem
       beschnittenen, die Punkte dem rohen. */
    function ticker() {
      var a = navEigen ? 0 : navZiel - navWeich, b = rohZiel - rohWeich;
      var f = Math.min(1, folgen * gsap.ticker.deltaRatio());
      var fertig = Math.abs(a) < 0.0008 && Math.abs(b) < 0.0008;
      if (!navEigen) navWeich = fertig ? navZiel : navWeich + a * f;
      rohWeich = fertig ? rohZiel : rohWeich + b * f;
      zeichnen();
      if (fertig) { gsap.ticker.remove(ticker); tickt = false; }
    }

    function jagen() {
      rohZiel = gefuehrt ? fuehrF : bruch();
      ankerNachziehen();
      navZiel = tor(rohZiel, navTor, anker);
      // Die Glättung ist ein Filter gegen ruckelige Eingaben. Führt
      // GSAP den Track selbst, ist die Eingabe schon weich — dann
      // legt der Filter nur eine zweite Verzögerung obendrauf, und
      // die Pille bleibt am Anfang sichtbar stehen.
      if (weich.matches || gefuehrt) {
        if (!navEigen) navWeich = navZiel;
        rohWeich = rohZiel;
        zeichnen();
      }
      else if (!tickt) { tickt = true; gsap.ticker.add(ticker); }

      var n = klemm(Math.round(navZiel));
      if (n !== navIndex) { navIndex = n; navZustand(n); }
      blendZu(klemm(Math.round(tor(rohZiel, fadeTor, anker))));
    }

    /* ── Zeichnen ────────────────────────────────────────────────
       Läuft pro Frame. Deshalb: keine gsap.set-Aufrufe (jeder baut
       intern einen Tween), keine Schreibvorgänge auf Werte, die
       sich nicht geändert haben. Ein unveränderter style-Write
       kostet den Browser trotzdem eine Neuberechnung. */
    var iAlt = { t: '', w: -1, h: -1 }, hAlt = -1;
    var navVor = 0, letzterFrame = -1, dehnung = 0;

    // Tempo → Form: je schneller die Pille läuft, desto mehr zieht sie
    // sich in Laufrichtung lang und wird flacher. Gemessen wird pro
    // Frame, nicht pro Aufruf — zeichnen() läuft manchmal mehrfach im
    // selben Frame, und der zweite Aufruf sähe sonst Tempo null.
    function formen() {
      if (!shapeKraft) return 0;
      var frame = gsap.ticker.frame;
      if (frame === letzterFrame) return dehnung;
      letzterFrame = frame;
      var v = Math.abs(navWeich - navVor);
      navVor = navWeich;
      var ziel = Math.min(CFG.shapeMax, v * CFG.shapeK) * shapeKraft;
      // Aufbauen darf sie schnell, zurückgehen langsamer — sonst
      // flackert die Form bei jedem Tempowechsel.
      dehnung = ziel > dehnung ? ziel : dehnung + (ziel - dehnung) * 0.25;
      return dehnung;
    }

    function zeichnen() {
      if (hatNav && rects.length) {
        var f = navWeich;
        var i0 = Math.max(0, Math.floor(f)), i1 = Math.min(slides.length - 1, Math.ceil(f)), t = f - i0;
        var a = rects[i0], b = rects[i1];
        var x = Math.round((mix(a.left, b.left, t) + schub.v) * 10) / 10;
        var y = Math.round(mix(a.top, b.top, t) * 10) / 10;
        var w = Math.round(mix(a.width, b.width, t) * 10) / 10;
        var h = Math.round(mix(a.height, b.height, t) * 10) / 10;
        var dh = formen();
        var sx = Math.round((1 + dh) * 1000) / 1000;
        var sy = Math.round(stauch.v * (1 - dh * 0.6) * 1000) / 1000;
        var tf = 'translate3d(' + x + 'px,' + y + 'px,0)'
               + (sx === 1 && sy === 1 ? '' : ' scale(' + sx + ',' + sy + ')');
        if (tf !== iAlt.t) { indicator.style.transform = tf; iAlt.t = tf; }
        if (w !== iAlt.w) { indicator.style.width = w + 'px'; iAlt.w = w; }
        if (h !== iAlt.h) { indicator.style.height = h + 'px'; iAlt.h = h; }
      }

      // Solange die Punkte weg sind, muss ihre Größe nicht pro Frame
      // nachgerechnet werden — nur der aktive Zustand muss stimmen,
      // falls sie gleich auftauchen.
      if (gleitet || dotAktiv !== klemm(Math.round(rohWeich))) punkteMalen(rohWeich);

      if (!live) return;
      var g = tor(rohWeich, fadeTor, anker);
      var j0 = Math.max(0, Math.floor(g)), j1 = Math.min(slides.length - 1, Math.ceil(g)), tt = g - j0;
      faden.forEach(function (liste) {
        liste.forEach(function (s, i) {
          var d = Math.min(1, Math.abs(i - g));
          var o = Math.round((1 - d * fadeStaerke) * 1000) / 1000;
          if (s._tabsO !== o) {
            s.style.opacity = o;
            if (s._tabsV !== 1) { s.style.visibility = ''; s._tabsV = 1; }
            s._tabsO = o;
