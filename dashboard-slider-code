    var nav = root.querySelector('[data-tabs-nav]') || aussen('data-tabs-nav');

    // Alles, was üblicherweise in der Nav sitzt, wird in beiden
    // Bereichen gesucht: Wrapper und ausgelagerte Nav.
    var bereiche = (nav && !root.contains(nav)) ? [root, nav] : [root];
    function eins(sel) {
      for (var i = 0; i < bereiche.length; i++) {
        var e = bereiche[i].querySelector(sel);
        if (e) return e;
      }
      return null;
    }
    function alle(sel) {
      var out = [];
      bereiche.forEach(function (b) { out = out.concat(qq(b, sel)); });
      return out;
