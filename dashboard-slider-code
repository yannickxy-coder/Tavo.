    folgen:       0.24,  // Trägheit der Pille pro Frame (kleiner = weicher)
    navTor:       0,     // Pille läuft am Finger mit
    fadeTor:      0.3,   // Blende setzt nach knapp einem Drittel ein
    fadeDauer:    0.28,
    fadeStaerke:  1,
    swapDauer:    0.26,  // Text ⇄ Punkte
    morphDauer:   0.5,   // Breite der Pille — bewusst länger als der Inhalt
    hoverAus:     0.12,
    reise:        0.48,  // Sprung per Button
    reiseKurve:   'power3.out',
    navKurve:     'power2.inOut',  // eigene Kurve der Pille, wenn aktiviert
    zurueckReise: 0.42,  // Nachfedern nach dem Loslassen
    ueberschwung: 6,     // px — dezent, kein Cartoon
    stauchen:     0.13,
    zurueck:      0.42,
    hoehe:        0.45,
    dotsHold:     1100,
    intro:        1400,  // ms, wie lange die Punkte beim Seitenaufruf stehen
    wurf:         0.3,   // px/ms, ab wann ein Zug als Wurf zählt
    wurfWeg:      0.12,  // Anteil der Trackbreite, der ohne Wurf reicht
    dotAbfall:    0.3,   // wieviel kleiner je Schritt nach außen
    dotMin:       0.4,   // Untergrenze der Punktgröße
    dotFenster:   5,     // wieviele Punkte breit die Pille höchstens wird
    shape:        1,     // Verformung der Pille beim Laufen
    shapeK:       2.2,   // Umrechnung Tempo → Dehnung
    shapeMax:     0.3    // Obergrenze der Dehnung
