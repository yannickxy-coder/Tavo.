    var indicator = eins('[data-tabs-indicator]');
    var ghost     = eins('[data-tabs-ghost]');
    var dotsBox   = eins('[data-tabs-dots]');
    var alleIdles = alle('[data-tabs-idle]');

    // Die Pille darf auch fehlen — dann ist es der Elternteil der
    // Punkte. Ohne Positionierung darauf würden die Punkte sonst
    // irgendwo auf der Seite kleben, weil sie absolut liegen.
    var pill = eins('[data-tabs-pill]')
            || (dotsBox && dotsBox.parentElement)
            || (alleIdles[0] && alleIdles[0].parentElement);
    if (pill && getComputedStyle(pill).position === 'static') pill.style.position = 'relative';

    var live = root.getAttribute('data-tabs-fade') === 'live';
    var autoHoehe = root.getAttribute('data-tabs-height') !== 'fixed';
    var hoverAn = root.getAttribute('data-tabs-pill-hover') !== 'off';
    var ziehenAn = root.getAttribute('data-tabs-drag') !== 'off';
    var sperreAus = root.getAttribute('data-tabs-swipe-desktop') === 'off';
    var abBreite = anteil(root, 'data-tabs-desktop', 992);
    var mqDesk = window.matchMedia('(min-width: ' + abBreite + 'px)');

    var navTor      = kappe(anteil(root, 'data-tabs-nav-threshold',  CFG.navTor), 0, 1);
    var fadeTor     = kappe(anteil(root, 'data-tabs-fade-threshold', CFG.fadeTor), 0, 1);
    var fadeDauer   = Math.max(0, anteil(root, 'data-tabs-fade-duration', CFG.fadeDauer));
    var fadeStaerke = kappe(anteil(root, 'data-tabs-fade-intensity', CFG.fadeStaerke), 0, 1);
    var swapDauer   = Math.max(0, anteil(root, 'data-tabs-swap-duration', CFG.swapDauer));
    var morphDauer  = Math.max(0, anteil(root, 'data-tabs-morph-duration', CFG.morphDauer));
    var folgen      = kappe(anteil(root, 'data-tabs-ease', CFG.folgen), 0.02, 1);
    var halten      = anteil(root, 'data-tabs-dots-hold', CFG.dotsHold);
    var reise       = Math.max(0, anteil(root, 'data-tabs-travel', CFG.reise));
    var reiseKurve  = root.getAttribute('data-tabs-travel-ease') || CFG.reiseKurve;
    if (!gsap.parseEase(reiseKurve)) {
      console.warn('[Tabs] data-tabs-travel-ease="' + reiseKurve + '" kennt GSAP nicht — es gilt ' + CFG.reiseKurve + '.', root);
      reiseKurve = CFG.reiseKurve;
    }
    var intro       = root.getAttribute('data-tabs-intro') === 'off'
                        ? 0 : anteil(root, 'data-tabs-intro', CFG.intro);

    // Eigene Kurve für die Pille: sobald eines der beiden Attribute
    // gesetzt ist, läuft sie beim Sprung nicht mehr auf der Kurve des
    // Tracks, sondern auf ihrer eigenen. Am Finger bleibt sie am Finger.
    var navEigenAn  = root.hasAttribute('data-tabs-nav-ease') || root.hasAttribute('data-tabs-nav-duration');
    var navDauer    = Math.max(0, anteil(root, 'data-tabs-nav-duration', reise));
    var navKurve    = root.getAttribute('data-tabs-nav-ease') || CFG.navKurve;
    if (navEigenAn && !gsap.parseEase(navKurve)) {
      console.warn('[Tabs] data-tabs-nav-ease="' + navKurve + '" kennt GSAP nicht — es gilt ' + CFG.navKurve + '.', root);
      navKurve = CFG.navKurve;
    }
    var boden       = 1 - fadeStaerke;   // Restdeckkraft des ausgeblendeten Inhalts
    var zentriert   = root.getAttribute('data-tabs-dots-center') !== 'off';
    var dotFenster  = Math.max(1, anteil(root, 'data-tabs-dots-window', CFG.dotFenster));
    var dotAbfall   = Math.max(0, anteil(root, 'data-tabs-dot-falloff', CFG.dotAbfall));
    var dotMin      = kappe(anteil(root, 'data-tabs-dot-min', CFG.dotMin), 0, 1);
    var shapeKraft  = Math.max(0, anteil(root, 'data-tabs-shape', CFG.shape));

    /* ── Buttons, Panels und Ruheinhalte zuordnen ────────────── */
    var ids = slides.map(function (s, i) {
      return s.getAttribute('data-tabs-slide') || String(i);
    });

    function paaren(liste, attr) {
      return ids.map(function (id, i) {
        var treffer = liste.filter(function (el) { return (el.getAttribute(attr) || '') === id; })[0];
        return treffer || liste[i] || null;
      });
    }

    var alleButtons = nav ? qq(nav, '[data-tabs-button]') : [];
    var buttons = paaren(alleButtons, 'data-tabs-button');
    var hatNav = Boolean(nav && indicator) && buttons.every(Boolean);
    if (nav && !hatNav) {
      console.warn('[Tabs] "' + name + '": ' + alleButtons.length + ' Buttons zu ' + slides.length + ' Slides, oder [data-tabs-indicator] fehlt — Nav läuft ohne Pille.', root);
    }

    var panelsWrap = eins('[data-tabs-panels]');
    var allePanels = alle('[data-tabs-panel]');
    var panels = allePanels.length ? paaren(allePanels, 'data-tabs-panel').filter(Boolean) : [];
    if (allePanels.length && panels.length !== slides.length) {
      console.warn('[Tabs] "' + name + '": ' + allePanels.length + ' Panels zu ' + slides.length + ' Slides — Panels bleiben aus.', root);
      panels = [];
    }
    if (panels.length && !panelsWrap) {
      console.warn('[Tabs] "' + name + '": Panels ohne [data-tabs-panels] — sie stehen untereinander statt übereinander.', root);
    }

    // Ein Ruheinhalt gilt für alles, mehrere gelten je Slide.
    var idles = alleIdles.slice(0, 1);
    if (alleIdles.length > 1) {
      if (alleIdles.length !== slides.length) {
        console.warn('[Tabs] "' + name + '": ' + alleIdles.length + ' Ruheinhalte zu ' + slides.length + ' Slides — es gilt nur der erste.', root);
      } else {
        idles = paaren(alleIdles, 'data-tabs-idle').filter(Boolean);
        // Sie müssen übereinander liegen, sonst zieht die Pille auf.
        var eltern = idles[0].parentElement;
        if (!idles.every(function (el) { return el.parentElement === eltern; })) {
          console.warn('[Tabs] "' + name + '": Die [data-tabs-idle] liegen in verschiedenen Containern — sie müssen sich denselben teilen.', root);
        } else {
          if (getComputedStyle(eltern).display.indexOf('grid') < 0) {
            eltern.style.display = 'grid';
            eltern.style.alignItems = 'center';
            eltern.style.justifyItems = 'center';
          }
          idles.forEach(function (el) { el.style.gridArea = '1/1'; });
        }
      }
    }
    var idleProSlide = idles.length > 1;

    var slideFade = panels.length
      ? root.getAttribute('data-tabs-slide-fade') === 'on'
      : root.getAttribute('data-tabs-slide-fade') !== 'off';
    var faden = [];
    if (panels.length) faden.push(panels);
    if (slideFade) faden.push(slides);

    /* ── Hintergrund ─────────────────────────────────────────────
       Ohne Wert: irgendwo im Wrapper. Mit Wert: irgendwo auf der
       Seite, z.B. am Body — damit auch die Seitenfarbe mitgehen
       kann, ohne dass sie im Wrapper liegen muss. */
