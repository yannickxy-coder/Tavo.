  var mix = function (a, b, t) { return a + (b - a) * t; };
  var dur = function (d) { return weich.matches ? 0 : d; };
  var kappe = function (v, a, b) { return Math.max(a, Math.min(b, v)); };

  // "0.5" und "50%" sollen beide gehen — im Designer tippt man mal so,
  // mal so, und ein stiller NaN wäre die schlechteste aller Antworten.
  function anteil(el, attr, fb) {
    var s = el.getAttribute(attr);
    if (s === null || s === '') return fb;
    var prozent = s.indexOf('%') > -1;
    var v = parseFloat(s);
    if (isNaN(v)) { console.warn('[Tabs] ' + attr + '="' + s + '" ist keine Zahl — es gilt ' + fb + '.', el); return fb; }
