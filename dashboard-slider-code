    var track  = root.querySelector('[data-tabs-track]');
    var slides = track ? qq(track, '[data-tabs-slide]') : [];
    if (!track || !slides.length) {
      console.warn('[Tabs] Kein [data-tabs-track] oder keine [data-tabs-slide] darin.', root);
      return null;
    }

    var name = root.getAttribute('data-tabs') || 'tabs';

    /* ── Wo darf gesucht werden? ─────────────────────────────────
       Ein Element gehört zu dieser Instanz, wenn es IM Wrapper
       liegt — oder wenn es AUSSERHALB liegt und sein Attributwert
       dem Namen der Instanz entspricht:

         <div data-tabs="reservierungen"> … Track … </div>
         <div data-tabs-nav="reservierungen"> … Pille … </div>

       Damit kann die Navigation an einer ganz anderen Stelle im
       DOM stehen, etwa in einer fixierten Leiste am unteren Rand.
       Ohne Wert bleibt alles wie bisher. */
    function aussen(attr) {
